PORT=3000
CORS_ORIGIN=*

# Firebase Admin - chọn 1 trong 2 cách:
# 1) Đường dẫn tới file service account JSON
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# 2) Hoặc khai báo trực tiếp
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
