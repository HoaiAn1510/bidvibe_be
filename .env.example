# Copy file này thành .env và điền giá trị thật, không commit .env lên git.
# Danh sách khớp 1-1 với biến mà code đọc (src/config/env.js, middleware/errorHandler.js).

# Cổng server (không đặt thì 3000). App Flutter đang dùng 5000.
PORT=5000
CORS_ORIGIN=*
# development | production (production: lỗi 5xx chỉ trả "Lỗi hệ thống", không lộ chi tiết)
NODE_ENV=development

# PostgreSQL - theo schema trong migrations/
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bidvibe
DB_SSL=false
# Tuỳ chọn: số kết nối tối đa của pool (bỏ trống thì 10). Supabase session pooler chỉ cho
# 15 kết nối cho CẢ database, cộng dồn mọi bản đang chạy: npm run dev của từng người, test:be1,
# test:be2 (hai bộ test tự dùng 4), mỗi tiến trình thêm 1 kết nối riêng cho LISTEN của
# pause_listener. Không đổi sang transaction pooler (cổng 6543): LISTEN không chạy qua đó.
DB_POOL_MAX=4

# JWT cho xác thực (bắt buộc, không có giá trị mặc định)
JWT_SECRET=

# Supabase Storage: lưu ảnh tải từ điện thoại (POST /api/uploads/images). Bỏ trống thì server vẫn
# chạy, chỉ route tải ảnh trả 503 UPLOAD_NOT_CONFIGURED.
# Lấy trong Supabase Dashboard -> Project Settings -> API Keys (URL ở Project Settings -> Data API):
#   SUPABASE_URL          dạng https://<project-ref>.supabase.co
#   SUPABASE_SERVICE_KEY  "Secret key" (sb_secret_...) hoặc khoá legacy "service_role" (eyJ...).
#                         CHỈ đặt ở backend: không đưa vào app, không commit, không dán vào log/chat.
#   STORAGE_BUCKET        tên bucket (mặc định listing-photos); chưa có thì backend tự tạo (public).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=listing-photos

# Job tự giải ngân cho Seller sau 72 giờ kể từ khi giao (mặc định bật). false để tắt.
AUTO_PAYOUT_ENABLED=true

# API /api/dev cho FE test nhanh: rút ngắn phiên đang chạy, cho đơn quá hạn thanh toán (docs/fe-quickstart.md).
# Mặc định false. KHÔNG bật trên máy chạy buổi demo. Bật cũng không có tác dụng khi NODE_ENV=production.
DEV_TOOLS=false
