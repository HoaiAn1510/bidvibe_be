# Copy file này thành .env và điền giá trị thật, không commit .env lên git

PORT=5000
CORS_ORIGIN=*
# development | production (production: lỗi 5xx chỉ trả "Lỗi hệ thống", không lộ chi tiết)
NODE_ENV=development

# PostgreSQL - theo schema trong migrations/
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bidvibe
DB_SSL=false

# JWT cho xác thực
JWT_SECRET=

# Job tự giải ngân cho Seller sau 72 giờ kể từ khi giao (mặc định bật). false để tắt.
AUTO_PAYOUT_ENABLED=true

# AI API (gợi ý giá, chatbot, báo cáo). HIỆN CHƯA DÙNG: các tính năng AI đang trả
# nội dung soạn sẵn (xem docs/architecture.md), để trống cũng chạy được.
ANTHROPIC_API_KEY=
